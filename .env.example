# Copy this file to .env.local and fill it in. .env.local is never committed to GitHub.
# Use EITHER Vertex AI mode (recommended: your Google Cloud credit pays) OR a Gemini API key.

# A) Vertex AI mode
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-bucket-name
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_VIDEO_LOCATION=us-central1

# B) Gemini API key instead (comment out the Vertex lines above)
# GEMINI_API_KEY=

# Data. Firestore by default; "memory" keeps everything in memory (nothing survives a restart).
DATA_STORE=memory
# A long random string that signs visitors' anonymous IDs. Keep it the same between restarts.
# SESSION_SECRET=

# The curated library: JEV (TypeSafe) is the judge, ADMIN_CODE opens the curator page at /#curate
# JEV_API_KEY=
# ADMIN_CODE=
# REFLECT_DAILY_LIMIT=10

# Invite-only beta (Google sign-in + invite codes, instead of the passcode)
# INVITE_ONLY=true
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com

# Protection
# APP_PASSCODE=                       # lock the app behind a passcode (recommended until it goes public)
# RATE_LIMIT_PER_10MIN=40             # AI requests per visitor per 10 minutes
# GENERAL_RATE_LIMIT_PER_10MIN=400    # all requests per visitor per 10 minutes
# IMAGE_DAILY_LIMIT=20                # AI images per visitor per day
# CAPTION_DAILY_LIMIT=60              # caption sets per visitor per day
# GLOBAL_IMAGE_DAILY_LIMIT=500        # AI images per day for everyone together (cost guard)
# VIDEO_ENABLED=false                 # video is off unless this is true
# VIDEO_DAILY_LIMIT=5                 # video clips per day when video is on (they cost dollars each)

# Optional: model names, if Google renames them
# MODEL_TEXT=gemini-3.8-flash
# MODEL_IMAGE=gemini-3.1-flash-lite-image
# MODEL_EMBED=gemini-embedding-001
# MODEL_VIDEO=veo-3.1-fast-generate-001
