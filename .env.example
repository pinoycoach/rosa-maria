# Copy this file to .env.local and fill it in. .env.local is never committed to GitHub.
# Real values for the live server go in Google Secret Manager, never in this file or the chat.

# Data. Firestore by default; "memory" keeps everything in memory (nothing survives a restart).
DATA_STORE=memory
# GOOGLE_CLOUD_PROJECT=your-rosa-maria-project-id
# A long random string that signs visitors' anonymous IDs. Keep it the same between restarts.
# SESSION_SECRET=

# The reviewer's desk: ADMIN_CODE opens it at /#curate; JEV (TypeSafe) is the checker that flags problems
# ADMIN_CODE=
# JEV_API_KEY=
# JEV_BASE_URL=

# Invite-only beta (Google sign-in + invite codes, instead of the passcode)
# INVITE_ONLY=true
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com

# Protection
# APP_PASSCODE=                       # lock the app behind a passcode (recommended until it goes public)
# GENERAL_RATE_LIMIT_PER_10MIN=400    # requests per visitor per 10 minutes
